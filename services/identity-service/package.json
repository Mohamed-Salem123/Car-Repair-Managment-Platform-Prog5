                            "@types/express":  "^4.17.21",
                            "@types/jest":  "^29.5.11",
                            "@types/jsonwebtoken":  "^9.0.5",
                            "@types/node":  "^20.10.5",
                            "@types/supertest":  "^7.2.1",
                            "jest":  "^29.7.0",
                            "prisma":  "^5.7.0",
                            "supertest":  "^7.3.2",
